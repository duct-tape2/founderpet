# FounderPet Phase 2 market-ready patch
# Copy into .env.local and fill values before production deploy.

# Optional but strongly recommended. If set, POST /api/events and POST /api/pet require:
#   x-founderpet-secret: <this value>
FOUNDERPET_INGEST_SECRET=change_me_long_random_secret

# Supabase persistence. Without these, the app uses in-memory demo fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_only

# Existing webhook secrets can stay as-is.
STRIPE_WEBHOOK_SECRET=whsec_...
GITHUB_WEBHOOK_SECRET=...
